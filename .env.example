# Football Video Pipeline - Environment Configuration
# Copy this file to .env or run setup_and_run.bat to configure automatically.

# 1. Telegram Remote Studio (Required for mobile control)
# Get your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
# Get your Chat ID from @userinfobot or @raw_data_bot on Telegram
TELEGRAM_CHAT_ID="your_telegram_chat_id_here"

# 2. Groq LPU API Key (Required for lightning-fast GPT-OSS 120B viral scripts)
# Get your free key at https://console.groq.com/keys
GROQ_API_KEY="your_groq_api_key_here"

# 3. Visual Search Engines (Optional - Bing API for image auditing)
BING_API_KEY=""

# 4. YouTube Upload (Optional - for automated publishing)
YOUTUBE_CLIENT_SECRETS_FILE="config/client_secret.json"
YOUTUBE_TOKEN_FILE="config/youtube_token.json"
