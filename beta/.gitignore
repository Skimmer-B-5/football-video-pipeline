# Beta-specific gitignore
__pycache__/
*.py[cod]
.env
.env.local

# Beta databases
*.db
*.sqlite
data/*.db
data/beta_news.db
data/beta_retention.db

# Beta media and run caches
data/audio/*
!data/audio/.gitkeep
data/images/*
!data/images/.gitkeep
data/temp_*
cache/
logs/
output/*
evidence/*
remotion/node_modules/
remotion/temp_render_props.json
workspaces/**/*.wav
workspaces/**/*.mp4
workspaces/**/*.png
workspaces/**/*.jpg
multilang/**/*.wav
multilang/**/*.mp4
