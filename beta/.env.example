# 30' FOOTBALL PLUS — BETA ISOLATED ENVIRONMENT CONFIGURATION
# Copy to .env inside beta/ for custom beta-specific credentials.
# All beta executions use these variables and NEVER overwrite production credentials.

# Beta Groq LLM Inference (falls back to system GROQ_API_KEY if unset)
BETA_GROQ_API_KEY=""
BETA_GROQ_API_KEY_BACKUP=""

# Beta Telegram Bot (Independent bot or left empty for CLI-only execution)
BETA_TELEGRAM_BOT_TOKEN=""
BETA_TELEGRAM_CHAT_ID=""

# Pipeline Isolation Flags
BETA_ACTIVE="1"
BETA_DISABLE_YOUTUBE_PUBLISH="1"
